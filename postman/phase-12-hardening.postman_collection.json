{
  "info": {
    "name": "Swagger AI Agent - Phase 12 Hardening",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Invalid JSON payload",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{invalid" },
        "url": "{{baseUrl}}/spec/validate"
      }
    },
    {
      "name": "Large payload limit",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"document\": {}\n}" },
        "url": "{{baseUrl}}/spec/validate"
      }
    }
  ]
}
